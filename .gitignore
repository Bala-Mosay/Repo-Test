# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Type / lint caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets -- never commit credentials
.env
*.key
*.pem

# Downloaded paper artifacts (obtain from the official publisher page)
*.pdf

# Local repository checkouts used by tasks and evaluation.
# These are cloned on demand from the pinned URLs in the manifests.
.checkouts/

# Experiment outputs. Results are regenerated by re-running the experiment;
# only manifests and curated, explicitly-stamped reports are versioned.
experiments/results/
experiments/_diffgen/

# Generated benchmark data (fetched from upstream at runtime)
TDD_Bench.json
.repotest-eval/

