# RepoTest-Bridge provider configuration.
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Any OpenAI-compatible endpoint works. Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Local:      OPENAI_BASE_URL=http://localhost:11434/v1

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=llama-3.3-70b-versatile

# Optional: used only if --provider ollama is selected.
OLLAMA_BASE_URL=http://localhost:11434
